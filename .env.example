# =====================================================================
# AutoTrading 봇 환경 변수 템플릿 (.env.example)
# =====================================================================
# 이 파일을 깃허브에서 클론한 뒤, 파일명을 '.env'로 변경하고 본인의 진짜 키를 입력하세요.

# [한국투자증권(KIS) API 인증 정보]
KIS_APP_KEY="여기에_발급받은_APP_KEY를_입력하세요"
KIS_APP_SECRET="여기에_발급받은_APP_SECRET을_입력하세요"

# [계좌 정보]
KIS_CANO="12345678"
KIS_PRDT_CD="01"

# [텔레그램 봇 알림 설정]
TELEGRAM_TOKEN="여기에_봇_토큰을_입력하세요"
TELEGRAM_CHAT_ID="여기에_본인의_관리자용_챗_아이디를_입력하세요"
